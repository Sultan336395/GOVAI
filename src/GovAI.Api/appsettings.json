{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=govai;Username=govai;Password=CHANGE_ME;Include Error Detail=false"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Seed": {
    "Enabled": false,
    "AdminEmail": "admin@govai.local"
  },
  "Jwt": {
    "SigningKey": "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET",
    "Issuer": "govai",
    "Audience": "govai-api",
    "AccessTokenMinutes": 60
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "ExtractionModel": "gpt-4.1",
    "SummaryModel": "gpt-4.1-mini",
    "TimeoutSeconds": 90
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstanceName": "govai:"
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "GOVAI",
    "TimeoutSeconds": 30,
    "MaxRecipients": 50
  },

  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "govai",
    "Password": "CHANGE_ME",
    "VirtualHost": "/",
    "ExchangeName": "govai.events"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/govai-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
