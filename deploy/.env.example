# deploy/.env — bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası .gitignore ile dışlanmıştır; asla depoya eklemeyin.

# ---- PostgreSQL ----
POSTGRES_DB=govai
POSTGRES_USER=govai
# BOŞ BIRAKILMIŞTIR ve öyle kalmalıdır.
#
# Buraya bir varsayılan yazılsaydı, dosyayı kopyalayıp doldurmayı unutan her kurulum
# aynı — ve herkesin bildiği — parolayı kullanırdı. Boş değer compose tarafından
# açık bir hatayla reddedilir; sessizce çalışan zayıf bir kurulum oluşmaz.
#
# Üretmek için: openssl rand -base64 24
#
# Yalnızca altyapıyı Docker'da, API'yi yerelde çalıştıracaksanız (hibrit geliştirme)
# bu değer src/GovAI.Api/appsettings.Development.json içindeki parola ile aynı olmalıdır.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=govai
# Üretmek için: openssl rand -base64 24
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- API ----
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
# En az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWT_SIGNING_KEY=

# ---- Başlangıç verisi (yalnızca ilk kurulumda true yapın) ----
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@govai.local
SEED_ADMIN_PASSWORD=

# ---- Worker (veri toplama) kimliği ----
# Worker artık yönetici hesabıyla çalışmaz; sınırlı SystemIngest rolüyle bağlanır.
# Bu hesap yalnızca crawl/ingest/run uçlarına erişir; kullanıcı, rol, kiracı veya
# şirket yönetemez ve şirket raporlarını okuyamaz.
# Parola BURAYA YAZILMAZ; .env dosyasında veya secret deposunda tutulur.
# Üretmek için: openssl rand -base64 24
WORKER_EMAIL=worker@govai.local
WORKER_PASSWORD=

# ---- Yapay zekâ ----
# Boş bırakılırsa kural çıkarımı yalnızca deterministik kalıplarla çalışır,
# yönetici özetleri kural tabanlı metinle üretilir. Sistem AI'sız da çalışır.
OPENAI_API_KEY=

# ---- DeepTech analiz sağlayıcısı (Faz 3) ----
# ANAHTAR BU DOSYAYA YAZILMAZ. Burası örnektir ve depoda durur; gerçek değer
# yalnızca sunucudaki .env dosyasına (izin 600) girilir.
#
# Üçü birden (PROVIDER + API_KEY + MODEL) verilmezse sistem KURAL TABANLI çalışır
# ve bunu ekranda açıkça söyler: "Kural tabanlı analiz", "Yapay zekâ güveni:
# Kullanılamıyor". Eksik yapılandırmayla "hibrit analiz" GÖSTERİLMEZ.
#
# Model adı koda gömülü değildir; sağlayıcı modelini emekliye ayırdığında yalnızca
# bu satır değişir.
GOVAI_AI_ENABLED=true
GOVAI_AI_PROVIDER=none
GOVAI_AI_API_KEY=
GOVAI_AI_MODEL=

# Sınırlar. Modele giden metin ve kanıt sayısı bilerek kısıtlıdır: hem maliyet
# hem de gereksiz veri göndermemek için.
GOVAI_AI_TIMEOUT_SECONDS=30
GOVAI_AI_MAX_INPUT_TOKENS=8000
GOVAI_AI_MAX_OUTPUT_TOKENS=1500
GOVAI_AI_MAX_EVIDENCE_CHUNKS=20
GOVAI_AI_MAX_RETRIES=2

# ---- Web paneli ----
WEB_PORT=5180
WEB_ORIGIN=http://localhost:5180

# ---- Loglama ----
LOG_LEVEL=INFO

# ---- Paket aynaları (isteğe bağlı) ----
# Boş bırakın. Yalnızca Debian (deb.debian.org) veya PyPI (pypi.org) adreslerine
# ulaşılamayan ağlarda doldurun; imaj derlemesi bu aynalar üzerinden yapılır.
# Örnek: APT_MIRROR=https://mirrors.aliyun.com
#        PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
APT_MIRROR=
PIP_INDEX_URL=
