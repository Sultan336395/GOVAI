# deploy/.env — bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası .gitignore ile dışlanmıştır; asla depoya eklemeyin.

# ---- PostgreSQL ----
POSTGRES_DB=govai
POSTGRES_USER=govai
# Yalnızca altyapıyı Docker'da, API'yi yerelde çalıştıracaksanız (hibrit geliştirme)
# bu değer src/GovAI.Api/appsettings.Development.json içindeki parola ile aynı olmalıdır:
#   POSTGRES_PASSWORD=local-dev-only
# Tam Docker kurulumunda ise güçlü bir parola verin.
POSTGRES_PASSWORD=degistir-guclu-bir-parola
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=govai
RABBITMQ_PASSWORD=degistir-guclu-bir-parola
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- API ----
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
# En az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWT_SIGNING_KEY=degistir-en-az-32-karakterlik-rastgele-anahtar

# ---- Başlangıç verisi (yalnızca ilk kurulumda true yapın) ----
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@govai.local
SEED_ADMIN_PASSWORD=

# ---- Worker (veri toplama) kimliği ----
# Worker artık yönetici hesabıyla çalışmaz; sınırlı SystemIngest rolüyle bağlanır.
# Bu hesap yalnızca crawl/ingest/run uçlarına erişir; kullanıcı, rol, kiracı veya
# şirket yönetemez ve şirket raporlarını okuyamaz.
# Parola BURAYA YAZILMAZ; .env dosyasında veya secret deposunda tutulur.
# Üretmek için: openssl rand -base64 24
WORKER_EMAIL=worker@govai.local
WORKER_PASSWORD=

# ---- Yapay zekâ ----
# Boş bırakılırsa kural çıkarımı yalnızca deterministik kalıplarla çalışır,
# yönetici özetleri kural tabanlı metinle üretilir. Sistem AI'sız da çalışır.
OPENAI_API_KEY=

# ---- Web paneli ----
WEB_PORT=5180
WEB_ORIGIN=http://localhost:5180

# ---- Loglama ----
LOG_LEVEL=INFO

# ---- Paket aynaları (isteğe bağlı) ----
# Boş bırakın. Yalnızca Debian (deb.debian.org) veya PyPI (pypi.org) adreslerine
# ulaşılamayan ağlarda doldurun; imaj derlemesi bu aynalar üzerinden yapılır.
# Örnek: APT_MIRROR=https://mirrors.aliyun.com
#        PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
APT_MIRROR=
PIP_INDEX_URL=
